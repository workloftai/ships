#!/usr/sbin/nft -f
# ===================================================================
# Workloft fleet egress: DEFAULT-DENY ruleset.  *** NOT ARMED ***
# Generated by egress_guard.py. Review, then a human applies it with:
#     sudo nft -f this-file.nft
# Undo with:  sudo nft flush ruleset   (or reboot if unsaved).
#
# HONEST LIMITS: this allowlists by RESOLVED IP at generation time.
# CDN IPs drift and are shared, so this is a coarse backstop, not the
# real control. For robust domain allowlisting, front outbound traffic
# with an egress PROXY that allowlists by TLS SNI / Host header.
# Re-run this generator on a schedule if you do arm the L3 version.
# ===================================================================

table inet egress {
  chain output {
    type filter hook output priority 0; policy drop;

    ct state established,related accept
    oif "lo" accept
    udp dport 53 accept
    tcp dport 53 accept

    # --- model_apis ---
    ip daddr { 160.79.104.10 } tcp dport { 80, 443 } accept  # api.anthropic.com (Claude models (direct))
    ip daddr { 160.79.104.10 } tcp dport { 80, 443 } accept  # code.claude.com (Claude Code)
    ip daddr { 162.159.140.245, 172.66.0.243 } tcp dport { 80, 443 } accept  # api.openai.com (OpenAI models + image gen)
    ip daddr { 104.18.33.45, 172.64.154.211 } tcp dport { 80, 443 } accept  # openai.com (OpenAI (redirect host))
    ip daddr { 104.18.2.115, 104.18.3.115 } tcp dport { 80, 443 } accept  # openrouter.ai (routed models (deepseek, gpt, grok, kimi, qwen))
    ip daddr { 172.217.112.4, 172.217.113.4, 172.217.114.4, 172.217.115.4, 172.217.116.4, 172.217.117.4, 172.217.118.4, 172.217.119.4 } tcp dport { 80, 443 } accept  # generativelanguage.googleapis.com (Gemini models)
    ip daddr { 172.217.112.4, 172.217.113.4, 172.217.114.4, 172.217.115.4, 172.217.116.4, 172.217.117.4, 172.217.118.4, 172.217.119.4 } tcp dport { 80, 443 } accept  # www.googleapis.com (Google auth/token)
    ip daddr { 104.18.18.80, 104.18.19.80 } tcp dport { 80, 443 } accept  # api.x.ai (Grok (xAI))
    ip daddr { 47.245.163.4, 47.245.170.100 } tcp dport { 80, 443 } accept  # api.z.ai (GLM (Z.AI))
    ip daddr { 162.159.142.207, 172.66.2.203 } tcp dport { 80, 443 } accept  # mistral.ai (Mistral models)

    # --- backend ---
    ip daddr { 76.76.21.21 } tcp dport { 80, 443 } accept  # supabase.co (Supabase (audit log, app data, redvsred) all projects)

    # --- messaging ---
    ip daddr { 149.154.166.110 } tcp dport { 80, 443 } accept  # api.telegram.org (Telegram bridge (Bob, Whitney, Mac agents))

    # --- vcs_publish ---
    ip daddr { 140.82.121.3 } tcp dport { 80, 443 } accept  # github.com (ships-oss public mirror)
    ip daddr { 172.65.251.78 } tcp dport { 80, 443 } accept  # gitlab.com (expac + workloft.ai Pages)
    ip daddr { 216.24.57.15, 216.24.57.7 } tcp dport { 80, 443 } accept  # api.typefully.com (social queue)
    ip daddr { 216.150.1.1 } tcp dport { 80, 443 } accept  # typefully.com (social queue (web))

    # --- own ---
    ip daddr { 35.185.44.232 } tcp dport { 80, 443 } accept  # workloft.ai (own site (curl-verify ships/notes))

    # --- research_read ---
    ip daddr { 151.101.131.42, 151.101.195.42, 151.101.3.42, 151.101.67.42 } tcp dport { 80, 443 } accept  # arxiv.org (paper abstracts (arXiv-watch, /ahfu))
    ip daddr { 52.222.136.117, 52.222.136.38, 52.222.136.89, 52.222.136.92 } tcp dport { 80, 443 } accept  # huggingface.co (model cards / datasets)
    ip daddr { 209.216.230.207 } tcp dport { 80, 443 } accept  # news.ycombinator.com (HN digest)
    ip daddr { 34.160.168.181 } tcp dport { 80, 443 } accept  # hn.algolia.com (HN search API)
    ip daddr { 34.160.56.206 } tcp dport { 80, 443 } accept  # api.daily.dev (daily.dev digest)
    ip daddr { 151.101.1.140, 151.101.129.140, 151.101.193.140, 151.101.65.140 } tcp dport { 80, 443 } accept  # reddit.com (r/LocalLLaMA digest)
    ip daddr { 76.76.21.21 } tcp dport { 80, 443 } accept  # cursor.com (Cursor changelog (Walt idea-scoring source))

    # --- client_context ---
    ip daddr { 104.20.22.243, 172.66.174.246 } tcp dport { 80, 443 } accept  # ico.org.uk (ReferRoute/JN compliance refs)
    ip daddr { 151.101.0.144, 151.101.128.144, 151.101.192.144, 151.101.64.144 } tcp dport { 80, 443 } accept  # gov.uk (LA democracy + Ofsted refs (ReferRoute research))
    ip daddr { 159.69.242.35 } tcp dport { 80, 443 } accept  # lgjobs.com (LA outreach research)
    ip daddr { 130.211.32.14 } tcp dport { 80, 443 } accept  # linkedin.com (post-target validation)

    # everything else is dropped by policy above
    log prefix "egress-drop " level warn
  }
}
